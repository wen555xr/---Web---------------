# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，不会提交到仓库。

# MySQL 连接串（SQLAlchemy URI）
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@127.0.0.1:3306/netops?charset=utf8mb4

# Flask 密钥
SECRET_KEY=CHANGE_ME

# 模拟模式：True 时不连真实设备，返回仿真华为 VRP 输出
MOCK_MODE=True

# 配置备份输出目录（默认 backups/，可省略）
# BACKUP_DIR=/path/to/backups
